<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The UI runs on both the original .NET Framework (net48) and modern .NET
      (net8.0-windows). The forms were rewritten to use DataGridView / ToolStrip
      / StatusStrip, which exist on both runtimes, so a single source builds for
      each. WinForms on modern .NET is Windows-only.
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>BioSimUI</RootNamespace>
    <AssemblyName>BioSimUI</AssemblyName>
    <StartupObject>BioSimUI.simSetup</StartupObject>
    <!-- AssemblyInfo.cs is kept and maintained by hand. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- WinForms enablement for the modern .NET target. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Framework assemblies are referenced explicitly only on .NET Framework;
       on net8.0-windows they are provided by the Windows Desktop shared framework. -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostParasiteSim\HostParasiteSim.csproj" />
  </ItemGroup>

</Project>
