<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BioSimUI</RootNamespace>
    <AssemblyName>BioSimUI</AssemblyName>
    <StartupObject>BioSimUI.simSetup</StartupObject>
    <!-- AssemblyInfo.cs is kept and maintained by hand. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!--
      The legacy WinForms .resx files embed binary resources (toolbar image
      list, icons) that were serialised with BinaryFormatter. The modern SDK
      build pipeline reads them through System.Resources.Extensions instead.
      This only affects how UI resources are (de)serialised, not the simulation.
    -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime support for the preserialized WinForms resources (see above). -->
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostParasiteSim\HostParasiteSim.csproj" />
  </ItemGroup>

</Project>
