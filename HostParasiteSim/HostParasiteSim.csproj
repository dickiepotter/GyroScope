<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!--
      Multi-targeted so the simulation engine can run on both the original
      .NET Framework CLR (net48) and modern .NET (net8.0). The regression test
      runs against both to prove a fixed seed produces identical output.
    -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <RootNamespace>HostParasiteSim</RootNamespace>
    <AssemblyName>HostParasiteSim</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
